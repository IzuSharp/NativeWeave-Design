  "findings": [
    {
      "id": "DB-IR-001",
      "severity": "medium",
      "files": [
        "docs/contracts/async-v0.1.md"
      ],
      "sections": [
        "6 启动算法及失败补偿",
        "9 清理算法"
      ],
      "status": "closed_after_author_revision_and_independent_reread",
      "observation": "清理等待registration_ready与StartReturned，但注册失败、初始化失败和跳过start分支缺少明确的不会再发生事件的哨兵发布规则。模型将skip转换为setup=4，规范应同样明确。",
      "impact": "按字面实现可让cleanup永久等待未执行的Register/start返回，资源配额无法释放。",
      "requested_resolution": "补逐阶段失败补偿表；区分无context同步补偿、NoRegistration、StartSkipped/StartRejected；统一setup completion屏障及仅实际注册才drain；AS-02覆盖。",
      "resolution_location": "D06 sections 5/6/9; R09 report/evidence",
      "resolution": "Settled distinguishes NoRegistration/Registered and skipped/rejected/accepted-returned startup; explicit compensation table and Indeterminate quarantine prevent waiting on events that will never occur.",
      "remaining_validation": "Specific implementation, fault injection, C#/Rust/FFI/AOT tests remain pending in existing AS/CB/LT/ER tasks; finite model does not cover newly clarified branches."
    },
    {
      "id": "DB-IR-002",
      "severity": "medium",
      "files": [
        "docs/contracts/callback-v0.1.md",
        "docs/contracts/lifetime-v0.1.md"
      ],
      "sections": [
        "6 managed回调入口与普通用户代码",
        "7 重入、关闭与清理调度",
        "DisposeAsync成功保证"
      ],
      "status": "closed_after_author_revision_and_independent_reread",
      "observation": "native入口回调计数为0及native_retired不涵盖已排入managed dispatcher的notification与执行中handler。",
      "impact": "若未规定dispatcher关闭与排空，DisposeAsync可能成功后仍开始或继续执行本订阅handler，承诺不完整。",
      "requested_resolution": "明确关闭dispatcher准入的线性化点、pending通知处置、独立in-flight handler计数及drain；自等待继续拒绝；提供已排队/执行中handler与DisposeAsync交错验收。",
      "resolution_location": "D05 section 7.1; D04 invariants; R08 report/evidence",
      "resolution": "Dispatcher admission and active-handler counts are separate; explicit Dispose discards pending and joins active handlers; successful DisposeAsync includes dispatcher drain and rejects self-wait.",
      "remaining_validation": "Specific implementation, fault injection, C#/Rust/FFI/AOT tests remain pending in existing AS/CB/LT/ER tasks; finite model does not cover newly clarified branches."
    },
    {
      "id": "DB-IR-003",
      "severity": "medium",
      "files": [
        "docs/contracts/async-v0.1.md",
        "docs/contracts/error-v0.1.md"
      ],
      "sections": [
        "8 结果接管与Task发布",
        "managed callback普通失败"
      ],
      "status": "closed_after_author_revision_and_independent_reread",
      "observation": "若唯一native终态callback已进入但managed检查/记录普通失败，返回CALLBACK_FAILED时terminal_notice可能尚未被登记；native不能再发第二终态。",
      "impact": "仅要求native停止/失败仍不能证明TCS会settle；也不能用本地桥接错误抹掉数据库已知/Unknown effect。",
      "requested_resolution": "明确预分配no-throw终态/桥接错误latch和reserved completion slot；本地interop failure可Faulted，但保留native/domain effect证据；失效cookie/fatal单列隔离，不要求第二native终态。",
      "resolution_location": "D06 section 8; R09 report/evidence",
      "resolution": "Preallocated CAS-owned terminal latch always publishes notice_received on ordinary failure, uses reserved completion slot, preserves native status/effect and does not demand a second native terminal callback.",
      "remaining_validation": "Specific implementation, fault injection, C#/Rust/FFI/AOT tests remain pending in existing AS/CB/LT/ER tasks; finite model does not cover newly clarified branches."
    }
  ],
